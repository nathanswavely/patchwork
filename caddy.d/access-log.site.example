# An access log for troubleshooting. To use it, copy this file to
# caddy.d/access-log.site and reload Caddy (docs/DEPLOYMENT.md, "Your own
# Caddy config").
#
# No access log ships, and the shipped privacy policy says so. This one is
# short-lived and masks the client address to its /24 (or /48 for IPv6).
# Turning it on changes what the site keeps about people, so in the same
# sitting edit the privacy policy's "Technical records" paragraph at
# Administration → Legal: it says there is no log, and once this file is in
# place that sentence is false. See docs/DEPLOYMENT.md, "Visitor counts and
# access logs".
#
# The file lands in the caddy_data volume, at /data/access.log inside the
# caddy container.
log {
	output file /data/access.log {
		roll_size 20mb
		roll_keep 7
		roll_keep_for 168h
	}
	format filter {
		request>remote_ip ip_mask 24 48
		request>client_ip ip_mask 24 48
		request>headers>Cookie delete
		request>headers>Authorization delete
	}
}
