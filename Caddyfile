{$DOMAIN:localhost} {
	# Caddy's reverse_proxy ignores client-supplied X-Forwarded-For by
	# default and sets it from the connecting address itself; only
	# `trusted_proxies` opts into believing an incoming value. If another
	# proxy sits in front of Caddy, `server.trusted_proxies` in
	# patchwork.yaml is the setting that matters.
	reverse_proxy patchwork:8080
}
